<Window x:Class="Tavrynexo.Views.LeftoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Tavrynexo.Core"
        Title="Tavrynexo Uninstaller" Width="960" Height="680" MinWidth="780" MinHeight="500"
        WindowStartupLocation="CenterOwner" Icon="/Assets/icon.ico"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid Margin="28,24,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="{core:T LeftoverTitle}" FontSize="24" FontWeight="Bold"/>
                <TextBlock x:Name="SubText" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <Border Background="#1B2536" CornerRadius="10" Padding="14,10" Margin="0,12,0,0">
                    <TextBlock Text="{core:T LeftoverHint}" Foreground="{StaticResource MutedBrush}" FontSize="12.5" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <Grid Grid.Row="1" Margin="8,0,19,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="86"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="{core:T ColKind}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" FontWeight="SemiBold" Margin="0,6"/>
                <TextBlock Grid.Column="2" Text="{core:T ColPath}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" FontWeight="SemiBold" Margin="0,6"/>
                <TextBlock Grid.Column="3" Text="{core:T ColConfidence}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" FontWeight="SemiBold" Margin="0,6"/>
                <TextBlock Grid.Column="4" Text="{core:T ColSize}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" FontWeight="SemiBold" Margin="0,6"/>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="6">
                <ListBox x:Name="ItemList" Style="{StaticResource ListStyle}" ItemContainerStyle="{StaticResource RowItem}" SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="38">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="86"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding KindText}" FontSize="12.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding DisplayPath}" ToolTip="{Binding DisplayPath}" FontSize="12.5"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                <Border Grid.Column="3" CornerRadius="6" Padding="9,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#3D2F12"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHigh}" Value="True">
                                                    <Setter Property="Background" Value="#17352A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ConfidenceText}" FontSize="11.5" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHigh}" Value="True">
                                                        <Setter Property="Foreground" Value="#4ADE80"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Grid.Column="4" Text="{Binding SizeText}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SelText" Foreground="{StaticResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Content="{core:T BtnSelectAll}" Click="SelectAll_Click"/>
                    <Button Style="{StaticResource GhostButton}" Content="{core:T BtnSelectNone}" Click="SelectNone_Click"/>
                    <Button x:Name="DeleteBtn" Style="{StaticResource DangerButton}" Content="{core:T BtnDeleteSelected}" Click="Delete_Click"/>
                    <Button Style="{StaticResource GhostButton}" Content="{core:T Close}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="BusyOverlay" Visibility="Collapsed" Background="#CC0C1018">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource Border2Brush}" BorderThickness="1"
                    CornerRadius="16" Padding="30,26" HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
                <StackPanel>
                    <TextBlock Text="{core:T Deleting}" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="BusyText" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,16"/>
                    <ProgressBar IsIndeterminate="True" Height="4" BorderThickness="0"
                                 Foreground="{StaticResource AccentBrush}" Background="{StaticResource Panel2Brush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
