<Window x:Class="Tavrynexo.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Tavrynexo.Core"
        Title="Tavrynexo Uninstaller" Width="1200" Height="760" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" Icon="/Assets/icon.ico"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}">
            <Grid Margin="16,22,16,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="6,0,0,30">
                    <Image Source="/Assets/logo.png" Width="46" Height="46" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="Tavrynexo" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="UNINSTALLER" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavPrograms" Style="{StaticResource NavButton}" GroupName="nav" IsChecked="True"
                                 Tag="{StaticResource IconPrograms}" Content="{core:T NavPrograms}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavStore" Style="{StaticResource NavButton}" GroupName="nav"
                                 Tag="{StaticResource IconStore}" Content="{core:T NavStore}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavStartup" Style="{StaticResource NavButton}" GroupName="nav"
                                 Tag="{StaticResource IconStartup}" Content="{core:T NavStartup}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavJunk" Style="{StaticResource NavButton}" GroupName="nav"
                                 Tag="{StaticResource IconJunk}" Content="{core:T NavJunk}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="nav"
                                 Tag="{StaticResource IconSettings}" Content="{core:T NavSettings}" Checked="Nav_Checked"/>
                </StackPanel>

                <TextBlock Grid.Row="3" Text="{core:T Tagline}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                           TextWrapping="Wrap" Margin="8,0"/>
            </Grid>
        </Border>

        <!-- ================= Content ================= -->
        <Grid Grid.Column="1" Margin="30,26,30,22">

            <!-- == Programs == -->
            <Grid x:Name="ViewPrograms">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{core:T ProgramsTitle}" FontSize="26" FontWeight="Bold"/>
                        <TextBlock x:Name="ProgramsCountText" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Grid Grid.Column="1" Width="300" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Text="{core:T Search}" IsHitTestVisible="False" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="15,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>

                <Grid Grid.Row="1" Margin="8,0,19,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="96"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Style="{StaticResource HeaderButton}" Tag="Name" Click="SortHeader_Click" Content="{core:T ColName}"/>
                    <Button Grid.Column="2" Style="{StaticResource HeaderButton}" Tag="Publisher" Click="SortHeader_Click" Content="{core:T ColPublisher}"/>
                    <Button Grid.Column="3" Style="{StaticResource HeaderButton}" Tag="SizeBytes" Click="SortHeader_Click" Content="{core:T ColSize}"/>
                    <Button Grid.Column="4" Style="{StaticResource HeaderButton}" Tag="Version" Click="SortHeader_Click" Content="{core:T ColVersion}"/>
                    <Button Grid.Column="5" Style="{StaticResource HeaderButton}" Tag="InstallDate" Click="SortHeader_Click" Content="{core:T ColDate}"/>
                </Grid>

                <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="6">
                    <ListBox x:Name="ProgramList" Style="{StaticResource ListStyle}" ItemContainerStyle="{StaticResource RowItem}"
                             ItemTemplate="{StaticResource ProgramRow}" SelectionMode="Extended"
                             MouseDoubleClick="ProgramList_DoubleClick"/>
                </Border>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="-5,16,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Click="Uninstall_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,1,10,0"/>
                            <TextBlock Text="{core:T BtnUninstall}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerButton}" Click="Force_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Margin="0,1,10,0"/>
                            <TextBlock Text="{core:T BtnForce}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="OpenFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" Margin="0,1,10,0"/>
                            <TextBlock Text="{core:T BtnOpenFolder}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="RefreshPrograms_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,1,10,0"/>
                            <TextBlock Text="{core:T Refresh}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- == Store apps == -->
            <Grid x:Name="ViewStore" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{core:T StoreTitle}" FontSize="26" FontWeight="Bold"/>
                        <TextBlock x:Name="StoreCountText" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Grid Grid.Column="1" Width="300" VerticalAlignment="Center">
                        <TextBox x:Name="StoreSearchBox" Style="{StaticResource SearchBox}" TextChanged="StoreSearchBox_TextChanged"/>
                        <TextBlock Text="{core:T Search}" IsHitTestVisible="False" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="15,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=StoreSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>

                <Grid Grid.Row="1" Margin="8,0,19,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="96"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="{core:T ColName}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" FontWeight="SemiBold" Margin="0,6"/>
                    <TextBlock Grid.Column="2" Text="{core:T ColPublisher}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" FontWeight="SemiBold" Margin="0,6"/>
                    <TextBlock Grid.Column="4" Text="{core:T ColVersion}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" FontWeight="SemiBold" Margin="0,6"/>
                </Grid>

                <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="6">
                    <ListBox x:Name="StoreList" Style="{StaticResource ListStyle}" ItemContainerStyle="{StaticResource RowItem}"
                             ItemTemplate="{StaticResource ProgramRow}" SelectionMode="Extended"/>
                </Border>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="-5,16,0,0">
                    <Button Style="{StaticResource DangerButton}" Click="RemoveStore_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,1,10,0"/>
                            <TextBlock Text="{core:T BtnRemoveStore}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="RefreshStore_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,1,10,0"/>
                            <TextBlock Text="{core:T Refresh}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- == Startup == -->
            <Grid x:Name="ViewStartup" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="{core:T StartupTitle}" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="{core:T StartupHint}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="6">
                    <ListBox x:Name="StartupList" Style="{StaticResource ListStyle}" ItemContainerStyle="{StaticResource RowItem}"
                             SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="48">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Click="StartupToggle_Click" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Command}" ToolTip="{Binding Command}" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SourceText}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                                    <Button Grid.Column="3" Style="{StaticResource SmallGhostButton}" Content="{core:T BtnDeleteEntry}" Click="StartupDelete_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="-5,16,0,0">
                    <Button Style="{StaticResource GhostButton}" Click="RefreshStartup_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,1,10,0"/>
                            <TextBlock Text="{core:T Refresh}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- == Junk cleaner == -->
            <Grid x:Name="ViewJunk" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="{core:T JunkTitle}" FontSize="26" FontWeight="Bold"/>
                    <TextBlock x:Name="JunkTotalText" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="6">
                    <ListBox x:Name="JunkList" Style="{StaticResource ListStyle}" ItemContainerStyle="{StaticResource RowItem}"
                             SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="46">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="JunkCheck_Click" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="13.5" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="-5,16,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Click="JunkClean_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,1,10,0"/>
                            <TextBlock Text="{core:T BtnClean}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="JunkAnalyze_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Margin="0,1,10,0"/>
                            <TextBlock Text="{core:T BtnAnalyze}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- == Settings & About == -->
            <ScrollViewer x:Name="ViewSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{core:T SettingsTitle}" FontSize="26" FontWeight="Bold" Margin="0,0,0,18"/>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="24" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/logo.png" Width="84" Height="84" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Margin="20,0" VerticalAlignment="Center" MaxWidth="620">
                                <TextBlock Text="Tavrynexo Uninstaller" FontSize="20" FontWeight="Bold"/>
                                <TextBlock x:Name="VersionText" Foreground="{StaticResource AccentBrush}" FontSize="12.5" Margin="0,2,0,8"/>
                                <TextBlock Text="{core:T AboutText}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="20"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="24">
                        <StackPanel>
                            <TextBlock Text="{core:T Language}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="-5,0,0,22">
                                <RadioButton x:Name="LangAr" Style="{StaticResource ChipRadio}" GroupName="lang" Content="العربية" Checked="Lang_Checked"/>
                                <RadioButton x:Name="LangEn" Style="{StaticResource ChipRadio}" GroupName="lang" Content="English" Checked="Lang_Checked"/>
                            </StackPanel>

                            <CheckBox x:Name="OptRestore" Content="{core:T OptRestore}" Margin="0,0,0,14" Click="Option_Click"/>
                            <CheckBox x:Name="OptBackup" Content="{core:T OptBackup}" Margin="0,0,0,22" Click="Option_Click"/>

                            <StackPanel Orientation="Horizontal" Margin="-5,0,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="{core:T BtnOpenBackups}" Click="OpenBackups_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="{core:T BtnOpenLogs}" Click="OpenLogs_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= Busy overlay ================= -->
        <Grid x:Name="BusyOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#CC0C1018" Panel.ZIndex="50">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource Border2Brush}" BorderThickness="1"
                    CornerRadius="16" Padding="30,26" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="380" MaxWidth="560">
                <StackPanel>
                    <TextBlock x:Name="BusyText" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <ProgressBar IsIndeterminate="True" Height="4" BorderThickness="0"
                                 Foreground="{StaticResource AccentBrush}" Background="{StaticResource Panel2Brush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
